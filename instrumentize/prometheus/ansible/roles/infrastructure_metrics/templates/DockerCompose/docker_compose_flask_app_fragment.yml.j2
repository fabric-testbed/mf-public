# Run flask app to verify jwt

  flask-app:
    container_name: infrastructure-metrics_flask_app
    image: fabric-metrics-flask
    volumes:
      - ./flask_app:/code
      - "{{ base_data_dir }}/flaskapp/flask_session:/code/flask_session"

#    ports:
#      - "7777:7070"  # for testing only

    environment:
      - "PYTHONUNBUFFERED=1"
      - "API_USER_REFRESH_CHECK_MINUTES=120"
      - "FLASK_APP_SECRET_KEY={{flask_app_secret_key}}"
      - "VOUCH_JWT_SECRET={{vouch_jwt_secret}}"

    logging:
      driver: json-file
      options:
        max-size: "1024m"
        max-file: "5"

    restart: always
